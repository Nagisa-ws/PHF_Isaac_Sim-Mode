+        the stem junction B, and lifted by `lift` along the fruit axis."""
+        Rq = quat_axis(k, th)
+        Rm = np.zeros(9)
+        mujoco.mju_quat2Mat(Rm, Rq)
+        return B + Rm.reshape(3, 3) @ (gp - B) + self._twist_u * lift, quat_mul(Rq, q0)
+
+    def _potek_options(self, B, gp, q0, ang: float, lift_max: float) -> list:
+        """[(axis k, feasible angle)] of the two sideways snap directions, best first. Sideways = along the closing
+        direction of the jaws (tool x, made perpendicular to the fruit axis): the pads then PUSH the fruit over (normal
+        force) instead of holding it by friction, and the hand only rolls about its own approach axis - the smallest
+        possible swing through the leaves. Feasible = IK, no self / environment contact, clear of the other
+        perceived fruits and of the target's own stalk (same tests as the twist)."""
+        chk, sim, hc = self.arm.checker, self.sim, self.cfg.get("harvest", {})
+        chk.sync_from(sim.d)
+        u = self._twist_u
+        side = sim.tcp_rot()[:, 0].copy()
+        side -= u * float(side @ u)
+        if np.linalg.norm(side) < 1e-6:
+            return []
+        side /= np.linalg.norm(side)
+        lp = self.leaf_cloud
+        if len(lp):
+            lp = lp[np.linalg.norm(lp - gp[None, :], axis=1) < 0.5]
+        lr = np.full(len(lp), float(self.cfg["perception"].get("leaf_point_radius", 0.015)))
+        op, orad = self._perceived_fruit_points(include_target=False)
+        o_margin = float(hc.get("twist_fruit_margin", 0.025))
+        _, (sp, sr), _ = self.planner.hard_points(self.plan.fruit)
+        nonfinger = ~self.arm.finger_mask
+        s_margin = float(hc.get("twist_stalk_margin", 0.01))
+        if len(sp):
+            chk.has_contact(sim.d.qpos.copy())
+            s_margin = min(s_margin, chk.hard_clearance([world_segments(self.arm.caps, chk._data)], sp, sr, nonfinger) - 0.005)
+        dth = np.radians(float(hc.get("potek_plan_step_deg", 5.0)))
+        out = []
+        for sgn in (1.0, -1.0):
+            k = np.cross(u, sgn * side)              # rotating about u x d tilts the fruit top toward d
+            k /= np.linalg.norm(k)
+            q_full = sim.d.qpos.copy()
+            th, th_ok, s_min, segs = 0.0, 0.0, 1.0, []
+            while th < ang:
+                th = min(ang, th + dth)
+                p, qt = self._potek_pose(B, gp, q0, k, th, lift_max * th / ang)
+                q, info = self.arm.ik.solve(q_full, p, qt)
+                if info["position_error"] > 0.004 or np.max(np.abs(q - q_full[sim.arm_qadr])) > 0.6:
+                    break
+                q_full[sim.arm_qadr] = q
+                if chk.has_contact(q_full):
+                    break
+                if len(op) and chk.hard_clearance([world_segments(self.arm.caps, chk._data)], op, orad) < o_margin:
+                    break
+                if len(sp) and chk.hard_clearance([world_segments(self.arm.caps, chk._data)], sp, sr, nonfinger) < s_margin:
+                    break
+                th_ok = th
+                s_min = min(s_min, abs(np.sin(q[4])))
+                if len(lp):
+                    segs.append(world_segments(self.arm.caps, chk._data))
+            if th_ok < np.radians(float(hc.get("potek_min_feasible_deg", 15.0))):
+                continue
+            intr = 0.0
+            if len(lp) and segs:
+                clr = chk.min_clearance_along(segs, lp, lr)
+                intr = float(np.sum(np.clip(0.02 - clr, 0.0, None)))
+            out.append((k, th_ok, (min(th_ok, np.radians(30.0)), -intr, s_min)))
+        out.sort(key=lambda o: o[2], reverse=True)
+        return [(o[0], o[1]) for o in out]
+
+    def _potek(self, bonus: float, gp, q0, pivot) -> tuple[float, str | None]:
+        """[potek] Detach the gripped fruit the way a tea shoot is plucked: SNAP IT SIDEWAYS WHILE LIFTING. The hand
+        tilts the fruit about the stem junction (the bottom of the fruit) and lifts it along the fruit axis at the
+        same time, so the stalk is loaded in bending + tension until it snaps (FieldLOD/PlantField.check_break with
+        a bending strength). Replaces the twist about the fruit axis (harvest.detach_mode: potek):
+          * the snap direction that is feasible further and sweeps fewer perceived leaves is tried first, the other
+            side second; leaves stopping the hand (leaf guard / leaf force) turn it back, as in the twist,
+          * after the snap the fruit is lifted off the stalk, still tilted, and only then turned upright, so its
+            bottom does not run into the stalk top,
+          * neither side snapped it -> grip again on the widest section and pull along the fruit axis (tension)."""
+        sim, fld, rec, slot = self.sim, self.sim.field, self.rec, self.target_slot
+        hc = self.cfg.get("harvest", {})
+        u = self._twist_u
+        fr = self.plan.fruit
+        # stem junction = bottom of the fruit body on its axis, below the point the pads hold (camera estimate of the
+        # fruit height; the pads give the axis): the hand turns about it, so the fruit is neither stretched nor pushed
+        d_b = float((pivot - np.asarray(fr.center, float)) @ u) + float(fr.half_height) + float(hc.get("potek_pivot_below", 0.0))
+        d_b = float(np.clip(d_b, *hc.get("potek_pivot_range", [0.05, 0.16])))
+        B = pivot - u * d_b
+        tmax = np.radians(float(hc.get("potek_max_deg", 40.0)))
+        step = np.radians(float(hc.get("potek_step_deg", 1.0)))
+        back = np.radians(float(hc.get("potek_back_step_deg", 2.0)))
+        lift_max = float(hc.get("potek_lift", 0.03))
+        with self._compute("twist_plan"):
+            options = self._potek_options(B, gp, q0, tmax, lift_max)
+        if not options:
+            self._event("potek infeasible (reach / neighbour fruit in the swing) -> pull only")
+        f_abort = float(hc.get("twist_leaf_force_abort", 200.0))
+        broke = False
+
+        def go(k, th, lift) -> bool:
+            p, q = self._potek_pose(B, gp, q0, k, th, lift)
+            self.arm.servo_to(p, q)
+            return self._sim(1, "potek")
+
+        for n_dir, (k, th_max) in enumerate(options[:2]):
+            th, why = 0.0, "limit"
+            while th < th_max:
+                th = min(th_max, th + step)
+                if not go(k, th, lift_max * th / tmax):
+                    return bonus, self.failure
+                brk, fe, te = fld.check_break(slot, sim.d)
+                mb = float(fld.slots[slot].get("last_bend", 0.0))
+                rec.stem_force, rec.stem_torque = max(rec.stem_force, fe), max(rec.stem_torque, te)
+                if brk:
+                    fld.detach(slot, sim.d)
+                    rec.detached, rec.twist_deg = True, float(np.degrees(th))
+                    self._event(f"stem broke at potek {np.degrees(th):.0f} deg, lift {100 * lift_max * th / tmax:.1f} cm "
+                                f"(F {fe:.0f} N, bending {mb:.1f} N m)")
+                    bonus += self._w("detach_bonus", 10.0)
+                    broke = True
+                    break
+                c = sim.classify_contacts(slot)
+                if c["pad_left"] < 0.5 and c["pad_right"] < 0.5:
+                    return bonus, "grip_slip"
+                if self._leaf_guard("twist_guard_frac"):
+                    why = f"leaf root bent {np.degrees(self._root_bend):.0f} deg"
+                    break
+                if c["leaf"] > f_abort:
+                    why = f"leaf force {c['leaf']:.0f} N"
+                    break
+            rec.twist_deg = max(rec.twist_deg, float(np.degrees(th)))
+            lift = lift_max * th / tmax
+            if not broke:
+                self._event(f"potek {np.degrees(th):.0f} deg stopped ({why}), stem not broken"
+                            + (": trying the other side" if n_dir == 0 and len(options) > 1 else ""))
+            else:
+                for _ in range(int(hc.get("snap_settle_steps", 5))):       # let the snap ring out before moving
+                    if not go(k, th, lift):
+                        return bonus, self.failure
+                # lift the picked fruit off the stalk while it is still tilted, then turn it upright
+                l1, n_l = lift + float(hc.get("untwist_lift", 0.02)), int(hc.get("untwist_lift_steps", 10))
+                for j in range(n_l):
+                    if not go(k, th, lift + (l1 - lift) * (j + 1) / n_l):
+                        return bonus, self.failure
+                    cf = self._carry_check()
+                    if cf:
+                        return bonus, cf
+                lift = l1
+            th0, ramp, lift0 = th, np.radians(float(hc.get("untwist_ramp_deg", 25.0))), lift
+            while th > 0.0:
+                f = float(np.clip(th / ramp, 0.15, 1.0) * np.clip((th0 - th) / ramp + 0.3, 0.3, 1.0))
+                th = max(0.0, th - back * f)
+                if not go(k, th, lift0 if broke else lift_max * th / tmax):
+                    return bonus, self.failure
+                if broke:
+                    cf = self._carry_check()
+                    if cf:
+                        return bonus, cf
+                else:
+                    brk, fe, te = fld.check_break(slot, sim.d)
+                    if brk:
+                        fld.detach(slot, sim.d)
+                        rec.detached, broke = True, True
+                        self._event(f"stem broke while turning back (F {fe:.0f} N, T {te:.2f} N m)")
+                        bonus += self._w("detach_bonus", 10.0)
+            for _ in range(6):                           # settle upright
+                if not go(k, 0.0, lift0 if broke else 0.0):
+                    return bonus, self.failure
+            if broke:
+                break
+        if not broke and bool(hc.get("pull_up", True)):
+            fail = self._regrip_on_widest()
+            if fail is not None:
+                return bonus, fail
+            fail = self._pull_up()
+            if fail is not None:
+                return bonus, fail
+            if rec.detached:
+                bonus += self._w("detach_bonus", 10.0)
+        return bonus, None
+
